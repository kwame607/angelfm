# ---------------------------------------------------------------
# Angel FM — environment variables
# Copy to .env.local for development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser — only
# non-secret values belong there. Everything else is server-only.
# ---------------------------------------------------------------

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (public: safe for the browser, protected by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SERVER ONLY: bypasses RLS. Never expose.) ---
SUPABASE_SECRET_KEY=

# --- Cloudflare R2 (SERVER ONLY) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (custom domain or r2.dev URL), no trailing slash
R2_PUBLIC_BASE_URL=
